# ── Keybindings (vim-style) ──────────────────────────────────────────────────
# khal ships with vim defaults; we make them explicit here for clarity.
[keybindings]
up    = up, k
down  = down, j
left  = left, h, backspace
right = right, l, space
view  = enter
new   = n
delete = d
search = /
today = t
quit  = q, Q
save  = meta enter
export = e
duplicate = p
external_edit = meta E
log   = L
mark  = v
other = o
