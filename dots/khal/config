# khal — terminal calendar configuration
#
# Reads calendar data synced by vdirsyncer from ~/.local/share/calendars/
# Use `khal interactive` for the TUI, `khal list` for quick view.

[calendars]

[[google]]
path = ~/.local/share/calendars/google/*
type = discover
color = auto

[locale]
timeformat = %H:%M
dateformat = %Y-%m-%d
longdateformat = %Y-%m-%d
datetimeformat = %Y-%m-%d %H:%M
longdatetimeformat = %Y-%m-%d %H:%M
# Monday = 0, Sunday = 6
firstweekday = 0

[default]
highlight_event_days = true
# default_calendar is rendered by dotfiles.sh from the secrets file.
# See @@DEFAULT_CALENDAR@@ placeholder below.
default_calendar = @@DEFAULT_CALENDAR@@

[view]
theme = dark
# Show events from today through the next 7 days in `khal list`
event_format = {calendar-color}{cancelled}{start-end-time-style} {title}{repeat-symbol}{reset}

# ── DankColors palette ───────────────────────────────────────────────────────
# Mapped from the base16 DankColors theme used system-wide.
# Format: foreground, background, mono, foreground_high, background_high
