edit        = '', '', '',     '#faf8ff', '#141218'
edit focus  = '', '', 'bold', '#faf8ff', '#9d99a5'
button      = '', '', '',     '#faf8ff', '#9d99a5'
button focused = '', '', 'bold', '#141218', '#d7c6ff'
