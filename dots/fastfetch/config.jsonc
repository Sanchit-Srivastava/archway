{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "builtin",
    "padding": {
      "top": 0,
      "right": 4
    }
  },
  "display": {
    "separator": "  ",
    "color": {
      "keys": "blue",
      "title": "bright_blue",
      "separator": "bright_black"
    }
  },
  "modules": [
    // Vertically center the information beside the full-size distro logo.
    "break",
    "break",
    "break",
    {
      "type": "title",
      "format": "{user-name-colored}{at-symbol-colored}{host-name-colored}"
    },
    "separator",
    {
      "type": "os",
      "key": "os",
      "format": "{pretty-name}"
    },
    {
      "type": "host",
      "key": "host"
    },
    {
      "type": "kernel",
      "key": "kernel",
      "format": "{release}"
    },
    {
      "type": "uptime",
      "key": "uptime",
      "format": "{formatted}"
    },
    {
      "type": "packages",
      "key": "packages"
    },
    {
      "type": "shell",
      "key": "shell",
      "format": "{pretty-name} {version}"
    },
    {
      "type": "wm",
      "key": "session"
    },
    {
      "type": "terminal",
      "key": "terminal"
    },
    {
      "type": "cpu",
      "key": "cpu"
    },
    {
      "type": "gpu",
      "key": "gpu",
      "format": "{name}"
    },
    {
      "type": "memory",
      "key": "memory"
    },
    {
      "type": "disk",
      "key": "disk",
      "folders": "/"
    }
  ]
}
