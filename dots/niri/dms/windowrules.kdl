// @id=wr_1771493762109778571 @name=zen
window-rule {
    match app-id="^zen$"
    open-maximized true
}

// @id=wr_1785832932152255176 @name=com.mitchellh.ghostty
window-rule {
    match app-id="^com.mitchellh.ghostty$"
    open-maximized true
}

// @id=wr_1786086469169706710 @name=Bitwarden
window-rule {
    match app-id="^Bitwarden$"
    opacity 0.75
}

// @id=wr_1786575019748147100 @name=firefox
window-rule {
    match app-id="^firefox$"
    open-maximized true
}

// @id=wr_1786645490451591957 @name=org.gnome.Nautilus
window-rule {
    match app-id="^org.gnome.Nautilus$"
    opacity 0.75
    open-floating false
}
