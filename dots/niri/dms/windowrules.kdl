// @id=wr_1771493762109778571 @name=zen
window-rule {
    match app-id="^zen$"
    open-maximized true
}

// @id=wr_1772506667540162201 @name=Alacritty
window-rule {
    match app-id="^Alacritty$"
    open-floating true
}

// @id=wr_1772506734402026430 @name=Alacritty
window-rule {
    match app-id="^Alacritty$"
    opacity 0.80
}

// @id=wr_1785832932152255176 @name=com.mitchellh.ghostty
window-rule {
    match app-id="^com.mitchellh.ghostty$"
    open-maximized true
}

// @id=wr_1786086469169706710 @name=Bitwarden
window-rule {
    match app-id="^Bitwarden$"
    opacity 0.75
}
