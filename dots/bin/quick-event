#!/usr/bin/env bash
set -euo pipefail

# Quick-add a calendar event via fuzzel prompts.
# Feeds into `khal new` and triggers a vdirsyncer sync.
#
# Flow:
#   1. Pick a date (today / tomorrow / weekday / custom)
#   2. Enter start time
#   3. Enter end time (or skip for 1h default)
#   4. Enter event title
#
# Keybinding: bind this to e.g. Mod+Alt+N in your WM config.

FUZZEL="fuzzel --dmenu --width=45 --lines=8"

# ── Step 1: Date ─────────────────────────────────────────────────────────────
date_choice=$(printf '%s\n' \
	"today" \
	"tomorrow" \
	"monday" \
	"tuesday" \
	"wednesday" \
	"thursday" \
	"friday" \
	"saturday" \
	"sunday" | ${FUZZEL} --prompt="Date: ") || exit 0

[[ -z "$date_choice" ]] && exit 0

# ── Step 2: Start time ──────────────────────────────────────────────────────
start_time=$(printf '%s\n' \
	"08:00" \
	"09:00" \
	"10:00" \
	"11:00" \
	"12:00" \
	"13:00" \
	"14:00" \
	"15:00" \
	"16:00" \
	"17:00" \
	"18:00" \
	"19:00" \
	"20:00" | ${FUZZEL} --prompt="Start: ") || exit 0

[[ -z "$start_time" ]] && exit 0

# ── Step 3: End time (empty = 1h default) ────────────────────────────────────
end_time=$(printf '%s\n' \
	"" \
	"${start_time}" | head -1 | ${FUZZEL} --prompt="End (empty=+1h): ") || true

# ── Step 4: Title ────────────────────────────────────────────────────────────
title=$(echo "" | ${FUZZEL} --prompt="Title: ") || exit 0

[[ -z "$title" ]] && exit 0

# ── Build khal new command ───────────────────────────────────────────────────
cmd=(khal new)
cmd+=("$date_choice" "$start_time")
if [[ -n "$end_time" ]]; then
	cmd+=("$end_time")
fi
cmd+=("$title")

if "${cmd[@]}"; then
	notify-send "Calendar" "Added: ${title}" -t 3000
	# Sync in background
	systemctl --user start vdirsyncer.service 2>/dev/null &
else
	notify-send -u critical "Calendar" "Failed to add event" -t 5000
fi
