#!/usr/bin/env bash
set -euo pipefail

# Regenerate ~/notes/README.md and ~/notes/index.md from note frontmatter.
#
# README.md  -- standard markdown links (clickable on GitHub)
# index.md   -- wiki-links (navigable in Neovim via zk-nvim)
#
# Reads YAML frontmatter "title:" and "date:" from each .md file.
# Safe to re-run (overwrites both files each time).
#
# Usage:
#   zk-index              # rebuild README.md and index.md
#   zk-index --dry-run    # print to stdout without writing

NOTES_DIR="${ZK_NOTEBOOK_DIR:-$HOME/notes}"
README="${NOTES_DIR}/README.md"
INDEX="${NOTES_DIR}/index.md"
DRY_RUN=false
RECENT_LIMIT=20

if [[ "${1:-}" == "--dry-run" ]]; then
	DRY_RUN=true
fi

if [[ ! -d "${NOTES_DIR}/.zk" ]]; then
	printf "Error: %s is not a zk notebook (missing .zk/)\n" "${NOTES_DIR}" >&2
	exit 1
fi

# Extract title from YAML frontmatter, fall back to filename
get_title() {
	local file="$1"
	local title=""

	# Try to read title from frontmatter (first "title: ..." after opening ---)
	if head -20 "$file" | grep -q '^---'; then
		title=$(sed -n '/^---$/,/^---$/{ s/^title:[[:space:]]*//p; }' "$file" | head -1)
	fi

	# Strip surrounding quotes if present
	title="${title#\"}"
	title="${title%\"}"
	title="${title#\'}"
	title="${title%\'}"

	# Fall back to filename without extension
	if [[ -z "$title" ]]; then
		local base
		base=$(basename "$file" .md)
		# Convert slugs to readable titles: some-note-title -> Some note title
		title="${base//-/ }"
		title="$(printf '%s' "$title" | sed 's/\b\(.\)/\u\1/')"
	fi

	printf '%s' "$title"
}

# Get date from frontmatter
get_date() {
	local file="$1"
	local date=""

	if head -20 "$file" | grep -q '^---'; then
		date=$(sed -n '/^---$/,/^---$/{ s/^date:[[:space:]]*//p; }' "$file" | head -1)
	fi

	# Strip surrounding quotes
	date="${date#\"}"
	date="${date%\"}"
	date="${date#\'}"
	date="${date%\'}"

	printf '%s' "$date"
}

# Convert a file path to a wiki-link: papers/my-note.md -> [[papers/my-note]]
# Uses the piped display format: [[path|Title]]
make_wiki_link() {
	local rel_path="$1"
	local title="$2"
	# Strip .md extension for wiki-link target
	local target="${rel_path%.md}"
	printf '[[%s|%s]]' "$target" "$title"
}

# Build a section listing notes from a directory.
# Args: directory_path link_format
#   link_format: "markdown" for README.md, "wiki" for index.md
build_section() {
	local dir="$1"
	local link_format="$2"
	local dir_name
	dir_name=$(basename "$dir")

	local -a entries=()

	# Find all .md files in this directory (non-recursive)
	while IFS= read -r -d '' file; do
		local rel_path title date entry
		rel_path="${file#"${NOTES_DIR}/"}"
		title=$(get_title "$file")
		date=$(get_date "$file")

		if [[ "$link_format" == "wiki" ]]; then
			local wikilink
			wikilink=$(make_wiki_link "$rel_path" "$title")
			if [[ -n "$date" ]]; then
				entry="- ${wikilink} _(${date})_"
			else
				entry="- ${wikilink}"
			fi
		else
			if [[ -n "$date" ]]; then
				entry="- [${title}](${rel_path}) _(${date})_"
			else
				entry="- [${title}](${rel_path})"
			fi
		fi
		entries+=("$entry")
	done < <(find "$dir" -maxdepth 1 -name '*.md' -type f -print0 | sort -z)

	if [[ ${#entries[@]} -eq 0 ]]; then
		return
	fi

	# Capitalize section name
	local heading
	heading="$(printf '%s' "$dir_name" | sed 's/\b\(.\)/\u\1/')"

	printf '## %s\n\n' "$heading"
	printf '%s\n' "${entries[@]}"
	printf '\n'
}

# Build root-level notes section (excluding README.md and index.md)
# Args: link_format ("markdown" or "wiki")
build_root_section() {
	local link_format="$1"
	local -a entries=()

	while IFS= read -r -d '' file; do
		local base rel_path title date entry
		base=$(basename "$file")
		if [[ "$base" == "README.md" || "$base" == "index.md" ]]; then
			continue
		fi
		rel_path="${file#"${NOTES_DIR}/"}"
		title=$(get_title "$file")
		date=$(get_date "$file")

		if [[ "$link_format" == "wiki" ]]; then
			local wikilink
			wikilink=$(make_wiki_link "$rel_path" "$title")
			if [[ -n "$date" ]]; then
				entry="- ${wikilink} _(${date})_"
			else
				entry="- ${wikilink}"
			fi
		else
			if [[ -n "$date" ]]; then
				entry="- [${title}](${rel_path}) _(${date})_"
			else
				entry="- [${title}](${rel_path})"
			fi
		fi
		entries+=("$entry")
	done < <(find "${NOTES_DIR}" -maxdepth 1 -name '*.md' -type f -print0 | sort -z)

	if [[ ${#entries[@]} -eq 0 ]]; then
		return
	fi

	printf '## Other Notes\n\n'
	printf '%s\n' "${entries[@]}"
	printf '\n'
}

# Build "Recent Notes" section from most recently modified .md files
# Args: link_format ("markdown" or "wiki")
build_recent_section() {
	local link_format="$1"
	local -a entries=()

	# Find all .md files, sort by modification time (newest first), take top N
	# Exclude README.md, index.md, and anything under .zk/
	while IFS= read -r file; do
		local base rel_path title date entry
		base=$(basename "$file")
		if [[ "$base" == "README.md" || "$base" == "index.md" ]]; then
			continue
		fi
		rel_path="${file#"${NOTES_DIR}/"}"
		title=$(get_title "$file")
		date=$(get_date "$file")

		if [[ "$link_format" == "wiki" ]]; then
			local wikilink
			wikilink=$(make_wiki_link "$rel_path" "$title")
			if [[ -n "$date" ]]; then
				entry="- ${wikilink} _(${date})_"
			else
				entry="- ${wikilink}"
			fi
		else
			if [[ -n "$date" ]]; then
				entry="- [${title}](${rel_path}) _(${date})_"
			else
				entry="- [${title}](${rel_path})"
			fi
		fi
		entries+=("$entry")

		if [[ ${#entries[@]} -ge $RECENT_LIMIT ]]; then
			break
		fi
	done < <(find "${NOTES_DIR}" -name '*.md' -type f -not -path '*/.zk/*' \
		-printf '%T@ %p\n' | sort -rn | cut -d' ' -f2-)

	if [[ ${#entries[@]} -eq 0 ]]; then
		return
	fi

	printf '## Recent Notes\n\n'
	printf '%s\n' "${entries[@]}"
	printf '\n'
}

# --- Build the README (standard markdown links for GitHub) ---

readme_output="# Research Notes

> Auto-generated by \`zk-index\`. Do not edit manually.

"

sections=(papers journal ideas meetings)

for section in "${sections[@]}"; do
	dir="${NOTES_DIR}/${section}"
	if [[ -d "$dir" ]]; then
		section_output=$(build_section "$dir" "markdown")
		if [[ -n "$section_output" ]]; then
			readme_output+="${section_output}"
		fi
	fi
done

root_output=$(build_root_section "markdown")
if [[ -n "$root_output" ]]; then
	readme_output+="${root_output}"
fi

# --- Build the index.md (wiki-links for Neovim navigation) ---

index_output="---
title: Index
tags: [index]
---

# Research Notes

> Auto-generated by \`zk-index\`. Do not edit manually.
> Navigate with \`gf\` or \`<CR>\` on any wiki-link.

"

# Recent notes section first (most useful for daily work)
recent_output=$(build_recent_section "wiki")
if [[ -n "$recent_output" ]]; then
	index_output+="${recent_output}"
fi

for section in "${sections[@]}"; do
	dir="${NOTES_DIR}/${section}"
	if [[ -d "$dir" ]]; then
		section_output=$(build_section "$dir" "wiki")
		if [[ -n "$section_output" ]]; then
			index_output+="${section_output}"
		fi
	fi
done

root_output=$(build_root_section "wiki")
if [[ -n "$root_output" ]]; then
	index_output+="${root_output}"
fi

# --- Write or print ---

if [[ "$DRY_RUN" == true ]]; then
	printf '=== README.md ===\n\n'
	printf '%s' "$readme_output"
	printf '\n=== index.md ===\n\n'
	printf '%s' "$index_output"
else
	printf '%s' "$readme_output" >"$README"
	printf 'Updated %s (%d lines)\n' "$README" "$(wc -l <"$README")"
	printf '%s' "$index_output" >"$INDEX"
	printf 'Updated %s (%d lines)\n' "$INDEX" "$(wc -l <"$INDEX")"
fi
