#!/usr/bin/env bash
set -euo pipefail

# Regenerate ~/notes/README.md and ~/notes/index.md from note frontmatter.
#
# README.md  -- standard markdown links (clickable on GitHub)
# index.md   -- wiki-links (navigable in Neovim via zk-nvim)
#
# All notes live in entries/ (flat). Grouping is by frontmatter tags:
#   tags: [paper]   -> Papers section
#   tags: [journal] -> Journal section
#   tags: [meeting] -> Meetings section
#   tags: [idea]    -> Ideas section
#   (anything else) -> Other section
#
# Usage:
#   zk-index              # rebuild README.md and index.md
#   zk-index --dry-run    # print to stdout without writing

NOTES_DIR="${ZK_NOTEBOOK_DIR:-$HOME/notes}"
ENTRIES_DIR="${NOTES_DIR}/entries"
README="${NOTES_DIR}/README.md"
INDEX="${NOTES_DIR}/index.md"
DRY_RUN=false
RECENT_LIMIT=20

if [[ "${1:-}" == "--dry-run" ]]; then
	DRY_RUN=true
fi

if [[ ! -d "${NOTES_DIR}/.zk" ]]; then
	printf "Error: %s is not a zk notebook (missing .zk/)\n" "${NOTES_DIR}" >&2
	exit 1
fi

if [[ ! -d "${ENTRIES_DIR}" ]]; then
	printf "Error: %s does not exist\n" "${ENTRIES_DIR}" >&2
	exit 1
fi

# Extract title from YAML frontmatter, fall back to filename
get_title() {
	local file="$1"
	local title=""

	if head -20 "$file" | grep -q '^---'; then
		title=$(sed -n '/^---$/,/^---$/{ s/^title:[[:space:]]*//p; }' "$file" | head -1)
	fi

	# Strip surrounding quotes
	title="${title#\"}"
	title="${title%\"}"
	title="${title#\'}"
	title="${title%\'}"

	# Fall back to filename without extension
	if [[ -z "$title" ]]; then
		local base
		base=$(basename "$file" .md)
		title="${base//-/ }"
		title="$(printf '%s' "$title" | sed 's/\b\(.\)/\u\1/')"
	fi

	printf '%s' "$title"
}

# Get date from frontmatter
get_date() {
	local file="$1"
	local date=""

	if head -20 "$file" | grep -q '^---'; then
		date=$(sed -n '/^---$/,/^---$/{ s/^date:[[:space:]]*//p; }' "$file" | head -1)
	fi

	date="${date#\"}"
	date="${date%\"}"
	date="${date#\'}"
	date="${date%\'}"

	printf '%s' "$date"
}

# Get the first known tag from frontmatter (paper, journal, meeting, idea)
# Returns empty string if no known tag is found.
get_category() {
	local file="$1"
	local tags_line=""

	if head -20 "$file" | grep -q '^---'; then
		tags_line=$(sed -n '/^---$/,/^---$/{ s/^tags:[[:space:]]*//p; }' "$file" | head -1)
	fi

	# Check for known categories in the tags list
	for cat in paper journal meeting idea; do
		if printf '%s' "$tags_line" | grep -qw "$cat"; then
			printf '%s' "$cat"
			return
		fi
	done
}

# Format a single note entry as a markdown or wiki link
# Args: file link_format ("markdown" or "wiki")
format_entry() {
	local file="$1"
	local link_format="$2"
	local rel_path title date

	rel_path="${file#"${NOTES_DIR}/"}"
	title=$(get_title "$file")
	date=$(get_date "$file")

	if [[ "$link_format" == "wiki" ]]; then
		local target="${rel_path%.md}"
		if [[ -n "$date" ]]; then
			printf -- '- [[%s|%s]] _(%s)_' "$target" "$title" "$date"
		else
			printf -- '- [[%s|%s]]' "$target" "$title"
		fi
	else
		if [[ -n "$date" ]]; then
			printf -- '- [%s](%s) _(%s)_' "$title" "$rel_path" "$date"
		else
			printf -- '- [%s](%s)' "$title" "$rel_path"
		fi
	fi
}

# --- Categorize all notes ---

# Associative arrays to hold entries per category
declare -a paper_files=()
declare -a journal_files=()
declare -a meeting_files=()
declare -a idea_files=()
declare -a other_files=()

while IFS= read -r -d '' file; do
	cat=$(get_category "$file")
	case "$cat" in
	paper) paper_files+=("$file") ;;
	journal) journal_files+=("$file") ;;
	meeting) meeting_files+=("$file") ;;
	idea) idea_files+=("$file") ;;
	*) other_files+=("$file") ;;
	esac
done < <(find "${ENTRIES_DIR}" -maxdepth 1 -name '*.md' -type f -print0 | sort -z)

# Build a section from a file array
# Args: heading link_format files...
build_section() {
	local heading="$1"
	local link_format="$2"
	shift 2

	if [[ $# -eq 0 ]]; then
		return
	fi

	printf '## %s\n\n' "$heading"
	for file in "$@"; do
		format_entry "$file" "$link_format"
		printf '\n'
	done
	printf '\n'
}

# Build recent notes section (by mtime, across all entries)
# Args: link_format
build_recent_section() {
	local link_format="$1"
	local -a entries=()
	local count=0

	while IFS= read -r file; do
		entries+=("$(format_entry "$file" "$link_format")")
		count=$((count + 1))
		if [[ $count -ge $RECENT_LIMIT ]]; then
			break
		fi
	done < <(find "${ENTRIES_DIR}" -maxdepth 1 -name '*.md' -type f \
		-printf '%T@ %p\n' | sort -rn | cut -d' ' -f2-)

	if [[ ${#entries[@]} -eq 0 ]]; then
		return
	fi

	printf '## Recent Notes\n\n'
	printf '%s\n' "${entries[@]}"
	printf '\n'
}

# --- Build README.md (standard markdown links for GitHub) ---

readme_output="\`\`\`
███╗   ██╗ ██████╗ ████████╗███████╗███████╗
████╗  ██║██╔═══██╗╚══██╔══╝██╔════╝██╔════╝
██╔██╗ ██║██║   ██║   ██║   █████╗  ███████╗
██║╚██╗██║██║   ██║   ██║   ██╔══╝  ╚════██║
██║ ╚████║╚██████╔╝   ██║   ███████╗███████║
╚═╝  ╚═══╝ ╚═════╝    ╚═╝   ╚══════╝╚══════╝
\`\`\`

> Auto-generated by \`zk-index\`. Do not edit manually.

"

for category_args in \
	"Papers:markdown:paper_files" \
	"Journal:markdown:journal_files" \
	"Ideas:markdown:idea_files" \
	"Meetings:markdown:meeting_files" \
	"Other:markdown:other_files"; do

	IFS=: read -r heading fmt arr_name <<<"$category_args"
	declare -n arr="$arr_name"
	if [[ ${#arr[@]} -gt 0 ]]; then
		section=$(build_section "$heading" "$fmt" "${arr[@]}")
		readme_output+="${section}"
	fi
done

# --- Build index.md (wiki-links for Neovim navigation) ---

index_output="---
title: Index
tags: [index]
---

# Research Notes

> Auto-generated by \`zk-index\`. Do not edit manually.
> Navigate with \`gf\` or \`<CR>\` on any wiki-link.

"

# Recent notes first (most useful for daily work)
recent_output=$(build_recent_section "wiki")
if [[ -n "$recent_output" ]]; then
	index_output+="${recent_output}"
fi

for category_args in \
	"Papers:wiki:paper_files" \
	"Journal:wiki:journal_files" \
	"Ideas:wiki:idea_files" \
	"Meetings:wiki:meeting_files" \
	"Other:wiki:other_files"; do

	IFS=: read -r heading fmt arr_name <<<"$category_args"
	declare -n arr="$arr_name"
	if [[ ${#arr[@]} -gt 0 ]]; then
		section=$(build_section "$heading" "$fmt" "${arr[@]}")
		index_output+="${section}"
	fi
done

# --- Write or print ---

if [[ "$DRY_RUN" == true ]]; then
	printf '=== README.md ===\n\n'
	printf '%s' "$readme_output"
	printf '\n=== index.md ===\n\n'
	printf '%s' "$index_output"
else
	printf '%s' "$readme_output" >"$README"
	printf 'Updated %s (%d lines)\n' "$README" "$(wc -l <"$README")"
	printf '%s' "$index_output" >"$INDEX"
	printf 'Updated %s (%d lines)\n' "$INDEX" "$(wc -l <"$INDEX")"
fi
