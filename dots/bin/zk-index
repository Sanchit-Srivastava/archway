#!/usr/bin/env bash
set -euo pipefail

# Regenerate ~/notes/README.md and ~/notes/index.md from note frontmatter.
#
# Standard markdown links are used everywhere -- clickable on GitHub and
# navigable in Neovim via zk-nvim LSP (gf / <CR>).
#
# README.md  -- landing page: recent notes + tag-based sections
# index.md   -- Neovim entry point (same content, with YAML frontmatter)
#
# Tags are discovered dynamically from frontmatter. Any tag used in any note
# gets its own heading. Notes with multiple tags appear under each one.
# Notes with no tags appear under "Uncategorized".
#
# Usage:
#   zk-index              # rebuild README.md and index.md
#   zk-index --dry-run    # print to stdout without writing

NOTES_DIR="${ZK_NOTEBOOK_DIR:-$HOME/notes}"
ENTRIES_DIR="${NOTES_DIR}/entries"
DRY_RUN=false
RECENT_LIMIT=20

if [[ "${1:-}" == "--dry-run" ]]; then
	DRY_RUN=true
fi

if [[ ! -d "${NOTES_DIR}/.zk" ]]; then
	printf "Error: %s is not a zk notebook (missing .zk/)\n" "${NOTES_DIR}" >&2
	exit 1
fi

if [[ ! -d "${ENTRIES_DIR}" ]]; then
	printf "Error: %s does not exist\n" "${ENTRIES_DIR}" >&2
	exit 1
fi

BANNER='```
███╗   ██╗ ██████╗ ████████╗███████╗███████╗
████╗  ██║██╔═══██╗╚══██╔══╝██╔════╝██╔════╝
██╔██╗ ██║██║   ██║   ██║   █████╗  ███████╗
██║╚██╗██║██║   ██║   ██║   ██╔══╝  ╚════██║
██║ ╚████║╚██████╔╝   ██║   ███████╗███████║
╚═╝  ╚═══╝ ╚═════╝    ╚═╝   ╚══════╝╚══════╝
```'

# --- Helpers ---

# Extract title from YAML frontmatter, fall back to filename
get_title() {
	local file="$1"
	local title=""

	if head -20 "$file" | grep -q '^---'; then
		title=$(sed -n '/^---$/,/^---$/{ s/^title:[[:space:]]*//p; }' "$file" | head -1)
	fi

	title="${title#\"}"
	title="${title%\"}"
	title="${title#\'}"
	title="${title%\'}"

	if [[ -z "$title" ]]; then
		local base
		base=$(basename "$file" .md)
		title="${base//-/ }"
		title="$(printf '%s' "$title" | sed 's/\b\(.\)/\u\1/')"
	fi

	printf '%s' "$title"
}

# Get date from frontmatter
get_date() {
	local file="$1"
	local date=""

	if head -20 "$file" | grep -q '^---'; then
		date=$(sed -n '/^---$/,/^---$/{ s/^date:[[:space:]]*//p; }' "$file" | head -1)
	fi

	date="${date#\"}"
	date="${date%\"}"
	date="${date#\'}"
	date="${date%\'}"

	printf '%s' "$date"
}

# Get all tags from frontmatter as newline-separated list.
# Returns nothing if no tags found.
get_tags() {
	local file="$1"
	local tags_line=""

	if head -20 "$file" | grep -q '^---'; then
		tags_line=$(sed -n '/^---$/,/^---$/{ s/^tags:[[:space:]]*//p; }' "$file" | head -1)
	fi

	# Strip brackets: [paper, journal] -> paper, journal
	tags_line="${tags_line#\[}"
	tags_line="${tags_line%\]}"

	# Split on comma, trim whitespace, output one per line
	if [[ -n "$tags_line" ]]; then
		printf '%s' "$tags_line" | tr ',' '\n' | sed 's/^[[:space:]]*//;s/[[:space:]]*$//' | grep -v '^$'
	fi
}

# Title-case a tag name (paper -> Paper, follow-up -> Follow-Up)
titlecase() {
	printf '%s' "$1" | sed 's/\b\(.\)/\u\1/g'
}

# Format a single note entry as a standard markdown link
format_entry() {
	local file="$1"
	local rel_path title date

	rel_path="${file#"${NOTES_DIR}/"}"
	title=$(get_title "$file")
	date=$(get_date "$file")

	if [[ -n "$date" ]]; then
		printf -- '- [%s](%s) _(%s)_' "$title" "$rel_path" "$date"
	else
		printf -- '- [%s](%s)' "$title" "$rel_path"
	fi
}

# --- Scan all notes, discover tags, build per-tag file lists ---

# tag -> newline-separated list of file paths
declare -A tag_files=()
# Ordered list of discovered tags (preserves first-seen order)
declare -a tag_order=()
# Files with no tags at all
declare -a untagged_files=()

while IFS= read -r -d '' file; do
	has_tag=false

	while IFS= read -r tag; do
		has_tag=true

		# Skip the "index" meta-tag (used by index.md itself)
		if [[ "$tag" == "index" ]]; then
			continue
		fi

		# Track tag order (first seen)
		if [[ -z "${tag_files[$tag]+x}" ]]; then
			tag_order+=("$tag")
			tag_files[$tag]=""
		fi

		# Append file to this tag's list (newline-separated)
		if [[ -n "${tag_files[$tag]}" ]]; then
			tag_files[$tag]+=$'\n'
		fi
		tag_files[$tag]+="$file"
	done < <(get_tags "$file")

	if [[ "$has_tag" == false ]]; then
		untagged_files+=("$file")
	fi
done < <(find "${ENTRIES_DIR}" -maxdepth 1 -name '*.md' -type f -print0 | sort -z)

# Sort tags alphabetically
IFS=$'\n' read -r -d '' -a tag_order < <(printf '%s\n' "${tag_order[@]}" | sort && printf '\0') || true

# --- Build recent notes section ---

build_recent_section() {
	local -a entries=()
	local count=0

	while IFS= read -r file; do
		entries+=("$(format_entry "$file")")
		count=$((count + 1))
		if [[ $count -ge $RECENT_LIMIT ]]; then
			break
		fi
	done < <(find "${ENTRIES_DIR}" -maxdepth 1 -name '*.md' -type f \
		-printf '%T@ %p\n' | sort -rn | cut -d' ' -f2-)

	if [[ ${#entries[@]} -eq 0 ]]; then
		return
	fi

	printf '## Recent Notes\n\n'
	printf '%s\n' "${entries[@]}"
	printf '\n'
}

# --- Build tag sections ---

build_tag_sections() {
	for tag in "${tag_order[@]}"; do
		local heading
		heading=$(titlecase "$tag")
		printf '## %s\n\n' "$heading"

		while IFS= read -r file; do
			format_entry "$file"
			printf '\n'
		done <<<"${tag_files[$tag]}"
		printf '\n'
	done

	# Uncategorized section (notes with no tags at all)
	if [[ ${#untagged_files[@]} -gt 0 ]]; then
		printf '## Uncategorized\n\n'
		for file in "${untagged_files[@]}"; do
			format_entry "$file"
			printf '\n'
		done
		printf '\n'
	fi
}

# --- Build README.md ---

recent_output=$(build_recent_section)
tag_output=$(build_tag_sections)

readme_output="${BANNER}

> Auto-generated by \`zk-index\`. Do not edit manually.

"

if [[ -n "$recent_output" ]]; then
	readme_output+="${recent_output}"
fi

if [[ -n "$tag_output" ]]; then
	readme_output+="${tag_output}"
fi

# --- Build index.md (Neovim entry point -- same content, with frontmatter) ---

index_output="---
title: Index
tags: [index]
---

# Research Notes

> Auto-generated by \`zk-index\`. Do not edit manually.
> Navigate with \`gf\` or \`<CR>\` on any link.

"

if [[ -n "$recent_output" ]]; then
	index_output+="${recent_output}"
fi

if [[ -n "$tag_output" ]]; then
	index_output+="${tag_output}"
fi

# --- Write or print ---

if [[ "$DRY_RUN" == true ]]; then
	printf '=== README.md ===\n\n'
	printf '%s' "$readme_output"
	printf '\n=== index.md ===\n\n'
	printf '%s' "$index_output"
else
	printf '%s' "$readme_output" >"${NOTES_DIR}/README.md"
	printf 'Updated %s/README.md (%d lines)\n' "${NOTES_DIR}" "$(wc -l <"${NOTES_DIR}/README.md")"
	printf '%s' "$index_output" >"${NOTES_DIR}/index.md"
	printf 'Updated %s/index.md (%d lines)\n' "${NOTES_DIR}" "$(wc -l <"${NOTES_DIR}/index.md")"
fi
