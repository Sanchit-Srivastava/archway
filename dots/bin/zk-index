#!/usr/bin/env bash
set -euo pipefail

# Regenerate ~/notes/README.md, ~/notes/index.md, and ~/notes/topics/*.md
# from note frontmatter.
#
# Standard markdown links are used everywhere -- clickable on GitHub and
# navigable in Neovim via zk-nvim LSP (gf / <CR>).
#
# README.md   -- landing page: recent notes, category sections, topic directory
# index.md    -- Neovim entry point (same content, with YAML frontmatter)
# topics/*.md -- one auto-generated page per topic tag
#
# Notes have two frontmatter axes:
#   category: <string>   -- what kind of note (research, paper, meeting, ...)
#   tags: [t1, t2, ...]  -- topic tags (defense-qa, nonlocality, ...)
#
# Categories are displayed as top-level sections in the main index.
# Each note appears exactly once (under its category).
# Topics get a compact directory table in the main index, with links to
# per-topic pages in topics/ where full listings live.
#
# Usage:
#   zk-index              # rebuild everything
#   zk-index --dry-run    # print to stdout without writing

NOTES_DIR="${ZK_NOTEBOOK_DIR:-$HOME/notes}"
ENTRIES_DIR="${NOTES_DIR}/entries"
TOPICS_DIR="${NOTES_DIR}/topics"
DRY_RUN=false
RECENT_LIMIT=20

if [[ "${1:-}" == "--dry-run" ]]; then
	DRY_RUN=true
fi

if [[ ! -d "${NOTES_DIR}/.zk" ]]; then
	printf "Error: %s is not a zk notebook (missing .zk/)\n" "${NOTES_DIR}" >&2
	exit 1
fi

if [[ ! -d "${ENTRIES_DIR}" ]]; then
	printf "Error: %s does not exist\n" "${ENTRIES_DIR}" >&2
	exit 1
fi

BANNER='```
███╗   ██╗ ██████╗ ████████╗███████╗███████╗
████╗  ██║██╔═══██╗╚══██╔══╝██╔════╝██╔════╝
██╔██╗ ██║██║   ██║   ██║   █████╗  ███████╗
██║╚██╗██║██║   ██║   ██║   ██╔══╝  ╚════██║
██║ ╚████║╚██████╔╝   ██║   ███████╗███████║
╚═╝  ╚═══╝ ╚═════╝    ╚═╝   ╚══════╝╚══════╝
```'

# --- Category display configuration ---
# Preferred display order and human-readable names for known categories.
# Unknown categories appear at the end, alphabetically, title-cased.

declare -a CATEGORY_ORDER=(research paper meeting journal plan)
declare -A CATEGORY_DISPLAY=(
	[research]="Research Notes"
	[paper]="Paper Summaries"
	[meeting]="Meetings"
	[journal]="Journal"
	[plan]="Plans"
)

# --- Helpers ---

# Extract title from YAML frontmatter, fall back to filename
get_title() {
	local file="$1"
	local title=""

	if head -20 "$file" | grep -q '^---'; then
		title=$(sed -n '/^---$/,/^---$/{ s/^title:[[:space:]]*//p; }' "$file" | head -1)
	fi

	title="${title#\"}"
	title="${title%\"}"
	title="${title#\'}"
	title="${title%\'}"

	if [[ -z "$title" ]]; then
		local base
		base=$(basename "$file" .md)
		title="${base//-/ }"
		title="$(printf '%s' "$title" | sed 's/\b\(.\)/\u\1/')"
	fi

	printf '%s' "$title"
}

# Get date from frontmatter
get_date() {
	local file="$1"
	local date=""

	if head -20 "$file" | grep -q '^---'; then
		date=$(sed -n '/^---$/,/^---$/{ s/^date:[[:space:]]*//p; }' "$file" | head -1)
	fi

	date="${date#\"}"
	date="${date%\"}"
	date="${date#\'}"
	date="${date%\'}"

	printf '%s' "$date"
}

# Get category from frontmatter (single string, no brackets)
get_category() {
	local file="$1"
	local cat=""

	if head -20 "$file" | grep -q '^---'; then
		cat=$(sed -n '/^---$/,/^---$/{ s/^category:[[:space:]]*//p; }' "$file" | head -1)
	fi

	cat="${cat#\"}"
	cat="${cat%\"}"
	cat="${cat#\'}"
	cat="${cat%\'}"

	# Trim whitespace
	cat="$(printf '%s' "$cat" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')"

	printf '%s' "$cat"
}

# Get all tags from frontmatter as newline-separated list.
# Returns nothing if no tags found.
get_tags() {
	local file="$1"
	local tags_line=""

	if head -20 "$file" | grep -q '^---'; then
		tags_line=$(sed -n '/^---$/,/^---$/{ s/^tags:[[:space:]]*//p; }' "$file" | head -1)
	fi

	# Strip brackets: [paper, journal] -> paper, journal
	tags_line="${tags_line#\[}"
	tags_line="${tags_line%\]}"

	# Split on comma, trim whitespace, output one per line
	if [[ -n "$tags_line" ]]; then
		printf '%s' "$tags_line" | tr ',' '\n' | sed 's/^[[:space:]]*//;s/[[:space:]]*$//' | grep -v '^$'
	fi
}

# Title-case a string (paper -> Paper, follow-up -> Follow-Up)
titlecase() {
	printf '%s' "$1" | sed 's/\b\(.\)/\u\1/g'
}

# Get display name for a category
category_display_name() {
	local cat="$1"
	if [[ -n "${CATEGORY_DISPLAY[$cat]+x}" ]]; then
		printf '%s' "${CATEGORY_DISPLAY[$cat]}"
	else
		titlecase "$cat"
	fi
}

# Format a single note entry as a standard markdown link
format_entry() {
	local file="$1"
	local prefix="${2:-entries}"
	local rel_path title date

	rel_path="${prefix}/$(basename "$file")"
	title=$(get_title "$file")
	date=$(get_date "$file")

	if [[ -n "$date" ]]; then
		printf -- '- [%s](%s) _(%s)_' "$title" "$rel_path" "$date"
	else
		printf -- '- [%s](%s)' "$title" "$rel_path"
	fi
}

# Format a note entry for topic pages (relative path goes up one level)
format_entry_topic() {
	local file="$1"
	local rel_path title date cat cat_label

	rel_path="../entries/$(basename "$file")"
	title=$(get_title "$file")
	date=$(get_date "$file")
	cat=$(get_category "$file")

	if [[ -n "$cat" ]]; then
		cat_label=" \`${cat}\`"
	else
		cat_label=""
	fi

	if [[ -n "$date" ]]; then
		printf -- '- [%s](%s) _(%s)_%s' "$title" "$rel_path" "$date" "$cat_label"
	else
		printf -- '- [%s](%s)%s' "$title" "$rel_path" "$cat_label"
	fi
}

# --- Scan all notes, discover categories and tags ---

# category -> newline-separated list of file paths
declare -A cat_files=()
# Ordered list of discovered categories
declare -a cat_order_found=()
# tag -> newline-separated list of file paths
declare -A tag_files=()
# Ordered list of discovered tags
declare -a tag_order=()
# Files with no category
declare -a uncategorized_files=()

while IFS= read -r -d '' file; do
	# --- Category ---
	local_cat=$(get_category "$file")

	if [[ -z "$local_cat" ]]; then
		uncategorized_files+=("$file")
	else
		if [[ -z "${cat_files[$local_cat]+x}" ]]; then
			cat_order_found+=("$local_cat")
			cat_files[$local_cat]=""
		fi
		if [[ -n "${cat_files[$local_cat]}" ]]; then
			cat_files[$local_cat]+=$'\n'
		fi
		cat_files[$local_cat]+="$file"
	fi

	# --- Tags ---
	while IFS= read -r tag; do
		# Skip the "index" meta-tag
		if [[ "$tag" == "index" ]]; then
			continue
		fi

		if [[ -z "${tag_files[$tag]+x}" ]]; then
			tag_order+=("$tag")
			tag_files[$tag]=""
		fi

		if [[ -n "${tag_files[$tag]}" ]]; then
			tag_files[$tag]+=$'\n'
		fi
		tag_files[$tag]+="$file"
	done < <(get_tags "$file")

done < <(find "${ENTRIES_DIR}" -maxdepth 1 -name '*.md' -type f -print0 | sort -z)

# Sort tags alphabetically
if [[ ${#tag_order[@]} -gt 0 ]]; then
	IFS=$'\n' read -r -d '' -a tag_order < <(printf '%s\n' "${tag_order[@]}" | sort && printf '\0') || true
fi

# Build final category order: preferred order first (if they have notes),
# then any discovered categories not in the preferred list, alphabetically.
declare -a final_cat_order=()
for cat in "${CATEGORY_ORDER[@]}"; do
	if [[ -n "${cat_files[$cat]+x}" ]]; then
		final_cat_order+=("$cat")
	fi
done
# Add any categories not in CATEGORY_ORDER
declare -a extra_cats=()
for cat in "${cat_order_found[@]}"; do
	found=false
	for known in "${CATEGORY_ORDER[@]}"; do
		if [[ "$cat" == "$known" ]]; then
			found=true
			break
		fi
	done
	if [[ "$found" == false ]]; then
		extra_cats+=("$cat")
	fi
done
if [[ ${#extra_cats[@]} -gt 0 ]]; then
	IFS=$'\n' read -r -d '' -a extra_cats < <(printf '%s\n' "${extra_cats[@]}" | sort && printf '\0') || true
	final_cat_order+=("${extra_cats[@]}")
fi

# --- Build recent notes section ---

build_recent_section() {
	local -a entries=()
	local count=0

	while IFS= read -r file; do
		entries+=("$(format_entry "$file")")
		count=$((count + 1))
		if [[ $count -ge $RECENT_LIMIT ]]; then
			break
		fi
	done < <(find "${ENTRIES_DIR}" -maxdepth 1 -name '*.md' -type f -print0 |
		xargs -0 ls -t)

	if [[ ${#entries[@]} -eq 0 ]]; then
		return
	fi

	printf '## Recent Notes\n\n'
	printf '%s\n' "${entries[@]}"
	printf '\n'
}

# --- Build category sections ---

build_category_sections() {
	for cat in "${final_cat_order[@]}"; do
		local heading count
		heading=$(category_display_name "$cat")

		# Count notes in this category
		count=$(printf '%s\n' "${cat_files[$cat]}" | grep -c '.' || true)

		printf '## %s (%d)\n\n' "$heading" "$count"

		while IFS= read -r file; do
			format_entry "$file"
			printf '\n'
		done <<<"${cat_files[$cat]}"
		printf '\n'
	done

	# Uncategorized section
	if [[ ${#uncategorized_files[@]} -gt 0 ]]; then
		printf '## Uncategorized (%d)\n\n' "${#uncategorized_files[@]}"
		for file in "${uncategorized_files[@]}"; do
			format_entry "$file"
			printf '\n'
		done
		printf '\n'
	fi
}

# --- Build topic directory table ---

build_topic_directory() {
	if [[ ${#tag_order[@]} -eq 0 ]]; then
		return
	fi

	printf '## Topics\n\n'
	printf '| Topic | Notes |\n'
	printf '|-------|-------|\n'

	for tag in "${tag_order[@]}"; do
		local count
		count=$(printf '%s\n' "${tag_files[$tag]}" | grep -c '.' || true)
		printf '| [%s](topics/%s.md) | %d |\n' "$tag" "$tag" "$count"
	done
	printf '\n'
}

# --- Build per-topic pages ---

build_topic_pages() {
	if [[ "$DRY_RUN" == true ]]; then
		for tag in "${tag_order[@]}"; do
			printf '=== topics/%s.md ===\n\n' "$tag"
			printf -- '---\ntitle: "Topic: %s"\ntags: [index]\n---\n\n' "$tag"
			printf '# %s\n\n' "$tag"
			printf '> Auto-generated topic page. Do not edit manually.\n\n'

			while IFS= read -r file; do
				format_entry_topic "$file"
				printf '\n'
			done <<<"${tag_files[$tag]}"
			printf '\n'
		done
		return
	fi

	# Clean out old topic files and recreate directory
	rm -rf "${TOPICS_DIR}"
	mkdir -p "${TOPICS_DIR}"

	for tag in "${tag_order[@]}"; do
		local topic_file="${TOPICS_DIR}/${tag}.md"
		local content=""

		content+="---"$'\n'
		content+="title: \"Topic: ${tag}\""$'\n'
		content+="tags: [index]"$'\n'
		content+="---"$'\n'$'\n'
		content+="# ${tag}"$'\n'$'\n'
		content+="> Auto-generated topic page. Do not edit manually."$'\n'$'\n'

		while IFS= read -r file; do
			content+="$(format_entry_topic "$file")"$'\n'
		done <<<"${tag_files[$tag]}"

		printf '%s' "$content" >"$topic_file"
	done

	printf 'Updated %s/ (%d topic pages)\n' "${TOPICS_DIR}" "${#tag_order[@]}"
}

# --- Build README.md ---

recent_output=$(build_recent_section)
category_output=$(build_category_sections)
topic_dir_output=$(build_topic_directory)

readme_output="${BANNER}

> Auto-generated by \`zk-index\`. Do not edit manually.

"

if [[ -n "$recent_output" ]]; then
	readme_output+="${recent_output}"$'\n\n'
fi

if [[ -n "$category_output" ]]; then
	readme_output+="${category_output}"$'\n\n'
fi

if [[ -n "$topic_dir_output" ]]; then
	readme_output+="${topic_dir_output}"$'\n'
fi

# --- Build index.md ---

index_output="---
title: Index
tags: [index]
---

# Research Notes

> Auto-generated by \`zk-index\`. Do not edit manually.
> Navigate with \`gf\` or \`<CR>\` on any link.

"

if [[ -n "$recent_output" ]]; then
	index_output+="${recent_output}"$'\n\n'
fi

if [[ -n "$category_output" ]]; then
	index_output+="${category_output}"$'\n\n'
fi

if [[ -n "$topic_dir_output" ]]; then
	index_output+="${topic_dir_output}"$'\n'
fi

# --- Write or print ---

if [[ "$DRY_RUN" == true ]]; then
	printf '=== README.md ===\n\n'
	printf '%s' "$readme_output"
	printf '\n=== index.md ===\n\n'
	printf '%s' "$index_output"
	printf '\n'
	build_topic_pages
else
	printf '%s' "$readme_output" >"${NOTES_DIR}/README.md"
	printf 'Updated %s/README.md (%d lines)\n' "${NOTES_DIR}" "$(wc -l <"${NOTES_DIR}/README.md")"
	printf '%s' "$index_output" >"${NOTES_DIR}/index.md"
	printf 'Updated %s/index.md (%d lines)\n' "${NOTES_DIR}" "$(wc -l <"${NOTES_DIR}/index.md")"
	build_topic_pages
fi
