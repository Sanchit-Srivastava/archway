#!/usr/bin/env bash
set -euo pipefail

# Regenerate ~/notes/README.md with clickable links to all notes.
# Reads the YAML frontmatter "title:" from each .md file.
# Safe to re-run (overwrites README.md each time).
#
# Usage:
#   zk-index              # rebuild README.md
#   zk-index --dry-run    # print to stdout without writing

NOTES_DIR="${ZK_NOTEBOOK_DIR:-$HOME/notes}"
README="${NOTES_DIR}/README.md"
DRY_RUN=false

if [[ "${1:-}" == "--dry-run" ]]; then
	DRY_RUN=true
fi

if [[ ! -d "${NOTES_DIR}/.zk" ]]; then
	printf "Error: %s is not a zk notebook (missing .zk/)\n" "${NOTES_DIR}" >&2
	exit 1
fi

# Extract title from YAML frontmatter, fall back to filename
get_title() {
	local file="$1"
	local title=""

	# Try to read title from frontmatter (first "title: ..." after opening ---)
	if head -20 "$file" | grep -q '^---'; then
		title=$(sed -n '/^---$/,/^---$/{ s/^title:[[:space:]]*//p; }' "$file" | head -1)
	fi

	# Strip surrounding quotes if present
	title="${title#\"}"
	title="${title%\"}"
	title="${title#\'}"
	title="${title%\'}"

	# Fall back to filename without extension
	if [[ -z "$title" ]]; then
		local base
		base=$(basename "$file" .md)
		# Convert slugs to readable titles: some-note-title -> Some note title
		title="${base//-/ }"
		title="$(printf '%s' "$title" | sed 's/\b\(.\)/\u\1/')"
	fi

	printf '%s' "$title"
}

# Get date from frontmatter
get_date() {
	local file="$1"
	local date=""

	if head -20 "$file" | grep -q '^---'; then
		date=$(sed -n '/^---$/,/^---$/{ s/^date:[[:space:]]*//p; }' "$file" | head -1)
	fi

	printf '%s' "$date"
}

# Collect notes from a directory into a formatted list
# Args: directory_path section_name
build_section() {
	local dir="$1"
	local dir_name
	dir_name=$(basename "$dir")

	local -a entries=()

	# Find all .md files in this directory (non-recursive)
	while IFS= read -r -d '' file; do
		local rel_path title date
		rel_path="${file#"${NOTES_DIR}/"}"
		title=$(get_title "$file")
		date=$(get_date "$file")

		if [[ -n "$date" ]]; then
			entries+=("- [${title}](${rel_path}) _(${date})_")
		else
			entries+=("- [${title}](${rel_path})")
		fi
	done < <(find "$dir" -maxdepth 1 -name '*.md' -type f -print0 | sort -z)

	if [[ ${#entries[@]} -eq 0 ]]; then
		return
	fi

	# Capitalize section name
	local heading
	heading="$(printf '%s' "$dir_name" | sed 's/\b\(.\)/\u\1/')"

	printf '## %s\n\n' "$heading"
	printf '%s\n' "${entries[@]}"
	printf '\n'
}

# --- Build the README ---

output=""

# Header
output+="# Research Notes
"
output+="
"
output+="> Auto-generated by \`zk-index\`. Do not edit manually.
"
output+="
"

# Sections in display order
sections=(papers journal ideas meetings)

for section in "${sections[@]}"; do
	dir="${NOTES_DIR}/${section}"
	if [[ -d "$dir" ]]; then
		section_output=$(build_section "$dir")
		if [[ -n "$section_output" ]]; then
			output+="${section_output}"
		fi
	fi
done

# Root-level notes (excluding README.md and index.md)
root_entries=""
while IFS= read -r -d '' file; do
	base=$(basename "$file")
	if [[ "$base" == "README.md" || "$base" == "index.md" ]]; then
		continue
	fi
	rel_path="${file#"${NOTES_DIR}/"}"
	title=$(get_title "$file")
	date=$(get_date "$file")
	if [[ -n "$date" ]]; then
		root_entries+="- [${title}](${rel_path}) _(${date})_
"
	else
		root_entries+="- [${title}](${rel_path})
"
	fi
done < <(find "${NOTES_DIR}" -maxdepth 1 -name '*.md' -type f -print0 | sort -z)

if [[ -n "$root_entries" ]]; then
	output+="## Other Notes

"
	output+="${root_entries}
"
fi

# Write or print
if [[ "$DRY_RUN" == true ]]; then
	printf '%s' "$output"
else
	printf '%s' "$output" >"$README"
	printf 'Updated %s (%d lines)\n' "$README" "$(wc -l <"$README")"
fi
