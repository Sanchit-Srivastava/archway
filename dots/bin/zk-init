#!/usr/bin/env bash
set -euo pipefail

# Initialize the ~/notes zk notebook with config, templates, and directories.
# Safe to re-run (idempotent) -- skips files that already exist.
#
# NOTE: This is `zk-init` (with a hyphen), NOT `zk init`.
# `zk init` is zk's built-in command that creates a minimal config without
# templates or aliases. Always use `zk-init` instead.
#
# Layout:
#   ~/notes/
#   ├── .zk/config.toml + templates/   (zk config)
#   ├── entries/                        (all notes, flat)
#   ├── references/                     (Zotero BibTeX)
#   ├── index.md                        (wiki-links for Neovim)
#   └── README.md                       (standard links for GitHub)

NOTES_DIR="$HOME/notes"
ENTRIES_DIR="${NOTES_DIR}/entries"

GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

log_info() { printf "${GREEN}[INFO]${NC} %s\n" "$1"; }
log_warn() { printf "${YELLOW}[WARN]${NC} %s\n" "$1" >&2; }

# If the notebook was cloned AND has our config (with aliases), nothing to do.
# A repo with only a bare `zk init` config will NOT match (missing aliases).
if [[ -d "${NOTES_DIR}/.git" ]] &&
	git -C "${NOTES_DIR}" remote get-url origin &>/dev/null &&
	grep -q '\[alias\]' "${NOTES_DIR}/.zk/config.toml" 2>/dev/null; then
	log_info "Notebook already cloned and fully configured, nothing to initialize"
	log_info "  Remote: $(git -C "${NOTES_DIR}" remote get-url origin)"
	exit 0
fi

# Helper: write a file only if it doesn't exist yet
write_if_missing() {
	local path="$1"
	if [[ -f "$path" ]]; then
		log_info "Already exists: ${path}"
		return 0
	fi
	cat >"$path"
	log_info "Created: ${path}"
}

# Create directory structure
for dir in "${ENTRIES_DIR}" "${NOTES_DIR}/references" "${NOTES_DIR}/.zk/templates"; do
	mkdir -p "$dir"
done
log_info "Directory structure ready"

# Write zk config (flat structure, no groups -- templates select note type)
write_if_missing "${NOTES_DIR}/.zk/config.toml" <<'EOF'
[note]
filename = "{{slug title}}"
extension = "md"
template = "research-note.md"
default-title = "Untitled"
id-charset = "alphanum"
id-length = 4
id-case = "lower"

[tool]
editor = "nvim"
pager = "less -FRX"
fzf-preview = "bat -p --color always {-1}"

[format.markdown]
link-format = "wiki"
hashtags = true
colon-tags = true

[lsp]
diagnostics.wiki-title = "hint"
diagnostics.dead-link = "error"

[lsp.completion]
note-label = "{{title}}"
note-filter-text = "{{title}} {{path}}"
note-detail = "{{filename}}"

[alias]
journal = 'zk new --dir entries --template daily.md --title "$(date +%Y-%m-%d)" "$@"'
paper = 'zk new --dir entries --template paper-summary.md --title "$@"'
meeting = 'zk new --dir entries --template meeting-notes.md --title "$(date +%Y-%m-%d)-$1"'
idea = 'zk new --dir entries --template research-note.md --title "$@"'
recent = 'zk list --sort modified --limit 20'
EOF

# Write templates (zk looks in .zk/templates/ by default)
write_if_missing "${NOTES_DIR}/.zk/templates/daily.md" <<'TMPL'
---
date: "{{format-date now '%Y-%m-%d'}}"
tags: [journal]
---

# {{format-date now "%A, %B %d, %Y"}}

## Plan

-

## Notes

-

## End of day

-
TMPL

write_if_missing "${NOTES_DIR}/.zk/templates/paper-summary.md" <<'TMPL'
---
title: "{{title}}"
date: "{{format-date now '%Y-%m-%d'}}"
tags: [paper]
citekey:
arxiv:
authors:
---

# {{title}}

## Key Results

-

## Methods

-

## Relevance to My Work

-

## Questions / Follow-ups

-
TMPL

write_if_missing "${NOTES_DIR}/.zk/templates/meeting-notes.md" <<'TMPL'
---
title: "{{title}}"
date: "{{format-date now '%Y-%m-%d'}}"
tags: [meeting]
attendees:
---

# {{title}}

## Discussion

-

## Action Items

- [ ]
TMPL

write_if_missing "${NOTES_DIR}/.zk/templates/research-note.md" <<'TMPL'
---
title: "{{title}}"
date: "{{format-date now '%Y-%m-%d'}}"
tags: []
---

# {{title}}


TMPL

# Create index.md (placeholder -- zk-index will regenerate with real wiki-links)
write_if_missing "${NOTES_DIR}/index.md" <<'EOF'
---
title: Index
tags: [index]
---

# Research Notes

> Run `zk-index` to populate this file with wiki-links to all notes.

## Recent Notes

_(empty -- run `zk-index` after creating some notes)_
EOF

# Generate README.md and index.md with links to all notes
if command -v zk-index &>/dev/null; then
	zk-index
	log_info "Generated README.md and index.md via zk-index"
else
	write_if_missing "${NOTES_DIR}/README.md" <<'EOF'
# Research Notes

> Run `zk-index` to regenerate this file with links to all notes.

## Directories

- [entries/](entries/) -- All notes
- [references/](references/) -- Zotero BibTeX export
EOF
fi

# Ensure .gitignore exists
write_if_missing "${NOTES_DIR}/.gitignore" <<'EOF'
.zk/zk.db
EOF

# Initialize git repo if not already one
if [[ ! -d "${NOTES_DIR}/.git" ]]; then
	git -C "${NOTES_DIR}" init
	log_info "Initialized git repo"
fi

# Stage and commit any new files (covers both fresh and cloned-empty cases)
if [[ -n "$(git -C "${NOTES_DIR}" status --porcelain)" ]]; then
	git -C "${NOTES_DIR}" add -A
	git -C "${NOTES_DIR}" commit -m "Initial zk notebook setup"
	log_info "Committed initial notebook files"
else
	log_info "No new files to commit"
fi

log_info ""
log_info "zk notebook ready at ${NOTES_DIR}"
log_info "  Notes directory: ${ENTRIES_DIR}"
log_info ""
log_info "Next steps:"
log_info "  1. Add a git remote: cd ~/notes && git remote add origin <url>"
log_info "  2. Set up Zotero Better BibTeX auto-export to ~/notes/references/library.bib"
log_info "  3. Try: zk new --dir entries --title 'My first note'"
log_info "  4. Run: zk-index          (regenerate README.md and index.md)"
