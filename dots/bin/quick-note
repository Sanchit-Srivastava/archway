#!/usr/bin/env bash
set -euo pipefail

# Notes launcher — search or create zk notes from a fuzzel prompt.
# Opens in a persistent tmux "notes" session so all notes share one workspace.
#
# Bound to Mod+G in niri keybindings.

NOTES_DIR="$HOME/notes"
TMUX_SESSION="notes"

# ── tmux helpers ──────────────────────────────────────────────────────────────

# Ensure the persistent "notes" tmux session exists.
ensure_session() {
	if ! tmux has-session -t="$TMUX_SESSION" 2>/dev/null; then
		tmux new-session -ds "$TMUX_SESSION" -c "$NOTES_DIR"
	fi
}

# Focus an existing ghostty window attached to the notes session, or open one.
# After calling this, the new tmux window we just created will be visible.
focus_or_open_terminal() {
	# Check if any tmux client is currently attached to the notes session.
	local attached
	attached=$(tmux list-clients -t "$TMUX_SESSION" -F '#{client_name}' 2>/dev/null || true)

	if [[ -n "$attached" ]]; then
		# A client is attached — focus its ghostty window via niri.
		niri msg action focus-window --app-id ghostty 2>/dev/null || true
	else
		# No client attached (session was detached or terminal closed).
		# Use niri to spawn ghostty so the compositor manages the process
		# lifecycle directly — backgrounding with & from a niri-spawned
		# script causes the orphaned process to get cleaned up on exit.
		niri msg action spawn -- ghostty -e tmux attach-session -t "$TMUX_SESSION"
	fi
}

# Run a command in a new tmux window inside the notes session.
# Args: window-name command [args...]
tmux_run() {
	local win_name="$1"
	shift
	ensure_session
	tmux new-window -t "$TMUX_SESSION" -n "$win_name" -c "$NOTES_DIR" -- "$@"
}

# ── search notes ──────────────────────────────────────────────────────────────

do_search() {
	tmux_run "search" quick-note-search
	focus_or_open_terminal
}

# ── add note ──────────────────────────────────────────────────────────────────

do_add() {
	local note_type
	note_type=$(printf "journal\npaper\nidea\nmeeting\nnote" |
		fuzzel --dmenu --prompt="Type: " --width=30)
	[[ -z "$note_type" ]] && exit 0

	local title="" template="" zk_args=()

	case "$note_type" in
	journal)
		title="$(date +%Y-%m-%d)"
		template="daily.md"
		;;
	paper)
		title=$(echo "" | fuzzel --dmenu --prompt="Paper: " --width=50)
		[[ -z "$title" ]] && exit 0
		template="paper-summary.md"
		;;
	meeting)
		title=$(echo "" | fuzzel --dmenu --prompt="Meeting: " --width=50)
		[[ -z "$title" ]] && exit 0
		title="$(date +%Y-%m-%d)-${title}"
		template="meeting-notes.md"
		;;
	idea)
		title=$(echo "" | fuzzel --dmenu --prompt="Idea: " --width=50)
		[[ -z "$title" ]] && exit 0
		template="research-note.md"
		;;
	note)
		title=$(echo "" | fuzzel --dmenu --prompt="Title: " --width=50)
		[[ -z "$title" ]] && exit 0
		;;
	esac

	zk_args=(new --working-dir "$NOTES_DIR" --title "$title")
	if [[ -n "$template" ]]; then
		zk_args+=(--template "$template")
	fi
	zk_args+=(entries)

	tmux_run "new-note" zk "${zk_args[@]}"
	focus_or_open_terminal
}

# ── main menu ─────────────────────────────────────────────────────────────────

action=$(printf "Search notes\nAdd note" |
	fuzzel --dmenu --prompt="Notes: " --width=30)
[[ -z "$action" ]] && exit 0

case "$action" in
"Search notes") do_search ;;
"Add note") do_add ;;
esac
