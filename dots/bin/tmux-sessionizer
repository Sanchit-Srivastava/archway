#!/usr/bin/env bash
# tmux-sessionizer - fuzzy-jump to a project session
# Usage: tmux-sessionizer [directory]
#
# If a directory is passed, use it directly (e.g. from zsh completion).
# Otherwise opens an fzf picker over your zoxide history (same list as `zi`),
# so candidates reflect actual frecency rather than a static directory scan.
set -euo pipefail

# ── resolve target directory ──────────────────────────────────────────────────
if [[ -n "${1:-}" ]]; then
    selected="$1"
else
    if ! command -v zoxide &>/dev/null; then
        echo "tmux-sessionizer: zoxide is not installed" >&2
        exit 1
    fi

    selected=$(zoxide query --list | fzf --prompt='session: ' --height=40% --layout=reverse --border)
fi

[[ -z "${selected:-}" ]] && exit 0
[[ -d "$selected" ]] || { echo "tmux-sessionizer: not a directory: $selected" >&2; exit 1; }

session_name=$(basename "$selected" | tr '.' '_')

if ! tmux has-session -t="$session_name" 2>/dev/null; then
    tmux new-session -ds "$session_name" -c "$selected"
fi

# Switch if already inside tmux, otherwise attach
if [[ -n "${TMUX:-}" ]]; then
    tmux switch-client -t "$session_name"
else
    tmux attach-session -t "$session_name"
fi
