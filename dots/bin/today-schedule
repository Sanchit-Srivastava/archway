#!/usr/bin/env bash
set -euo pipefail

# Show today's khal schedule in a fuzzel popup.

entries=$(khal list today today \
	--format "{start-end-time-style} {title}" 2>/dev/null)

if [[ -z "$entries" ]]; then
	notify-send "Schedule" "Nothing scheduled today" -t 3000
else
	echo "$entries" | fuzzel --dmenu \
		--prompt="Today ($(date +%a)): " --width=60 --lines=10
fi
