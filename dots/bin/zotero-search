#!/usr/bin/env bash
set -euo pipefail

# Search Zotero library via Better BibTeX JSON-RPC, open PDF in Zathura.
# Uses fuzzel's fuzzy matching to filter results interactively.

ZOTERO_RPC="http://127.0.0.1:23119/better-bibtex/json-rpc"

bbt_rpc() {
	local method="$1" params="$2"
	curl -s "$ZOTERO_RPC" \
		-X POST -H "Content-Type: application/json" -H "Accept: application/json" \
		--data-binary "{\"jsonrpc\": \"2.0\", \"method\": \"$method\", \"params\": $params}"
}

# Get search query from user
query=$(echo "" | fuzzel --dmenu --prompt="Zotero: " --width=60)
[[ -z "$query" ]] && exit 0

# Escape query for safe JSON embedding
json_query=$(python3 -c "import sys, json; print(json.dumps(sys.argv[1]))" "$query")

# Search via BBT JSON-RPC
results=$(bbt_rpc "item.search" "[${json_query}]")

# Parse results into "citekey | title | authors" for fuzzel
# BBT item.search returns CSL-JSON: authors are in .author[] with .family/.given fields
entries=$(echo "$results" | jq -r '.result[] |
    "\(.citekey) | \(.title // "Untitled") | \(.author // [] | map(.family // .literal // "?") | join(", "))"' 2>/dev/null)

# If no results, try searching each word individually and merge results
if [[ -z "$entries" ]]; then
	read -ra words <<<"$query"
	if [[ ${#words[@]} -gt 1 ]]; then
		all_entries=""
		for word in "${words[@]}"; do
			word_json=$(python3 -c "import sys, json; print(json.dumps(sys.argv[1]))" "$word")
			word_results=$(bbt_rpc "item.search" "[${word_json}]")
			word_entries=$(echo "$word_results" | jq -r '.result[] |
				"\(.citekey) | \(.title // "Untitled") | \(.author // [] | map(.family // .literal // "?") | join(", "))"' 2>/dev/null)
			if [[ -n "$word_entries" ]]; then
				all_entries+="${word_entries}"$'\n'
			fi
		done
		# Deduplicate by citekey (first field)
		entries=$(echo "$all_entries" | awk -F' \\| ' '!seen[$1]++' | sed '/^$/d')
	fi
fi

[[ -z "$entries" ]] && notify-send "Zotero" "No results for: $query" -t 3000 && exit 0

# Let user pick - fuzzel does fuzzy matching on the displayed entries
selected=$(echo "$entries" | fuzzel --dmenu --prompt="Open: " --width=80 --lines=15)
[[ -z "$selected" ]] && exit 0

# Extract citekey
citekey=$(echo "$selected" | cut -d'|' -f1 | tr -d ' ')

# Get attachments via BBT — returns array of {path, open} objects
json_citekey=$(python3 -c "import sys, json; print(json.dumps(sys.argv[1]))" "$citekey")
attachments=$(bbt_rpc "item.attachments" "[${json_citekey}]")

# Find first PDF attachment that exists on disk
pdf_path=$(echo "$attachments" | jq -r '
    [.result[] | select(.path != null) | select(.path | test("\\.pdf$"; "i"))] |
    first // empty | .path' 2>/dev/null)

if [[ -n "${pdf_path:-}" ]] && [[ -f "$pdf_path" ]]; then
	zathura "$pdf_path" &
else
	# Try zotero:// open URL for any attachment (opens in Zotero's built-in viewer)
	zotero_url=$(echo "$attachments" | jq -r '
	    [.result[] | select(.open != null)] |
	    first // empty | .open' 2>/dev/null)

	if [[ -n "${zotero_url:-}" ]]; then
		notify-send "Zotero" "No local PDF, opening in Zotero" -t 2000
		xdg-open "$zotero_url"
	else
		# Last resort: search Google Scholar
		notify-send "Zotero" "No attachments found, opening in browser" -t 2000
		encoded=$(python3 -c "import sys, urllib.parse; print(urllib.parse.quote_plus(sys.argv[1]))" "$query")
		xdg-open "https://scholar.google.com/scholar?q=${encoded}"
	fi
fi
