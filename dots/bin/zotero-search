#!/usr/bin/env bash
set -euo pipefail

# Search Zotero library via Better BibTeX JSON-RPC, open PDF in Zathura.
# Uses fuzzel's fuzzy matching to filter results interactively.

ZOTERO_RPC="http://127.0.0.1:23119/better-bibtex/json-rpc"

bbt_rpc() {
	local method="$1" params="$2"
	curl -s "$ZOTERO_RPC" \
		-X POST -H "Content-Type: application/json" -H "Accept: application/json" \
		--data-binary "{\"jsonrpc\": \"2.0\", \"method\": \"$method\", \"params\": $params}"
}

# Get search query from user
query=$(echo "" | fuzzel --dmenu --prompt="Zotero: " --width=60)
[[ -z "$query" ]] && exit 0

# Build advanced search: search both creator and title for each word (OR logic).
# BBT item.search supports tuple arrays: [["joinMode","any"],["creator","contains","x"],...]
# This is a single RPC call that replaces slow per-word fallback loops.
search_params=$(python3 -c "
import sys, json
words = sys.argv[1].split()
terms = [['joinMode', 'any']]
for w in words:
    terms.append(['creator', 'contains', w])
    terms.append(['title', 'contains', w])
print(json.dumps(terms))
" "$query")

# Search via BBT JSON-RPC (advanced tuple syntax)
results=$(bbt_rpc "item.search" "[${search_params}]")

# Parse results into "identifier | title | authors" for fuzzel.
# BBT item.search returns CSL-JSON with added .citekey and .id fields.
# Use citekey as identifier when available; fall back to Zotero item id (prefixed with @).
# The @ prefix lets us distinguish citekeys from item ids when opening.
entries=$(echo "$results" | jq -r '.result[] |
    "\(.citekey // ("@" + .id) ) | \(.title // "Untitled") | \(.author // [] | map(.family // .literal // "?") | join(", "))"' 2>/dev/null || true)

[[ -z "$entries" ]] && notify-send "Zotero" "No results for: $query" -t 3000 && exit 0

# Let user pick - fuzzel does fuzzy matching on the displayed entries
selected=$(echo "$entries" | fuzzel --dmenu --prompt="Open: " --width=80 --lines=15)
[[ -z "$selected" ]] && exit 0

# Extract identifier and title from selection
identifier=$(echo "$selected" | cut -d'|' -f1 | tr -d ' ')
paper_title=$(echo "$selected" | cut -d'|' -f2 | sed 's/^ *//;s/ *$//')

# Try to open the PDF via item.attachments (requires a citekey, not an @id)
pdf_file=""
if [[ "$identifier" != @* ]]; then
	# identifier is a citekey — look up attachments
	json_citekey=$(python3 -c "import sys, json; print(json.dumps(sys.argv[1]))" "$identifier")
	attachments=$(bbt_rpc "item.attachments" "[${json_citekey}, \"*\"]")

	att_paths=$(echo "$attachments" | jq -r '.result[]?.path // empty' 2>/dev/null || true)

	# Prefer .pdf extension, fall back to mime-type check.
	# Items often have both HTML snapshots and PDFs — skip non-PDFs.
	fallback_file=""
	while IFS= read -r path; do
		[[ -z "$path" ]] && continue
		[[ -f "$path" ]] || continue
		if [[ "${path,,}" == *.pdf ]]; then
			pdf_file="$path"
			break
		elif [[ -z "$fallback_file" ]]; then
			mime=$(file -b --mime-type "$path" 2>/dev/null || true)
			[[ "$mime" == "application/pdf" ]] && fallback_file="$path"
		fi
	done <<<"$att_paths"
	pdf_file="${pdf_file:-$fallback_file}"
fi

if [[ -n "$pdf_file" ]]; then
	zathura "$pdf_file" &
elif [[ "$identifier" == @* ]]; then
	# No citekey — use viewer.viewPDF with the Zotero item id
	item_id="${identifier#@}"
	json_id=$(python3 -c "import sys, json; print(json.dumps(sys.argv[1]))" "$item_id")
	bbt_rpc "viewer.viewPDF" "[${json_id}, 0]" >/dev/null 2>&1 || true
	notify-send "Zotero" "Opening PDF in Zotero (no citekey)" -t 2000
else
	# citekey exists but no local PDF found — try zotero:// open URL
	zotero_url=$(echo "$attachments" | jq -r '.result[]?.open // empty' 2>/dev/null || true)
	zotero_url=$(echo "$zotero_url" | head -n1)

	if [[ -n "${zotero_url:-}" ]]; then
		notify-send "Zotero" "No local PDF, opening in Zotero" -t 2000
		xdg-open "$zotero_url"
	else
		# Last resort: search Google Scholar using the selected paper's title
		notify-send "Zotero" "No attachments found, searching for paper" -t 2000
		encoded=$(python3 -c "import sys, urllib.parse; print(urllib.parse.quote_plus(sys.argv[1]))" "$paper_title")
		xdg-open "https://scholar.google.com/scholar?q=${encoded}"
	fi
fi
