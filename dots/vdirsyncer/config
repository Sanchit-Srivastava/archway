# vdirsyncer config — Google Calendar two-way sync via CalDAV
#
# SETUP (one-time, on target machine):
#   1. Go to https://console.developers.google.com
#   2. Create a project, enable the "CalDAV API"
#   3. Create OAuth 2.0 credentials (Desktop app type)
#   4. Copy client_id and client_secret into ~/.config/vdirsyncer/secrets
#   5. Run: vdirsyncer discover google_calendar
#   6. Run: vdirsyncer sync
#
# Credentials are loaded from a separate file that is NOT tracked by git.
# See the [general] section below.

[general]
status_path = "~/.local/share/vdirsyncer/status/"

[pair google_calendar]
a = "google_calendar_local"
b = "google_calendar_remote"
collections = ["from a", "from b"]
metadata = ["color"]
# Remote (Google) wins on conflict — phone edits take priority over
# local edits made between syncs.  Change to "a wins" if you prefer
# the opposite.
conflict_resolution = "b wins"

[storage google_calendar_local]
type = "filesystem"
path = "~/.local/share/calendars/google/"
fileext = ".ics"

[storage google_calendar_remote]
type = "google_calendar"
token_file = "~/.local/share/vdirsyncer/google_token"
# Credentials are read from a secrets file — see dotfiles.sh setup notes.
# Populate ~/.config/vdirsyncer/secrets with:
#   VDIRSYNCER_GOOGLE_CLIENT_ID=<your-client-id>
#   VDIRSYNCER_GOOGLE_CLIENT_SECRET=<your-client-secret>
client_id.fetch = ["command", "sh", "-c", ". ~/.config/vdirsyncer/secrets && printf '%s' \"$VDIRSYNCER_GOOGLE_CLIENT_ID\""]
client_secret.fetch = ["command", "sh", "-c", ". ~/.config/vdirsyncer/secrets && printf '%s' \"$VDIRSYNCER_GOOGLE_CLIENT_SECRET\""]
