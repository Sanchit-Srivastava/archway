# Git configuration
# Edit user.name and user.email before first use!

[user]
    name = Sanchit
    email = sanchit.srivastava@uwaterloo.ca
    # SSH commit signing — key is supplied by the Bitwarden SSH agent on every
    # machine (axiom/fractal/tangent/vector). Using the literal `key::` form
    # avoids any per-host file path. The matching public key is registered as
    # a "Signing Key" on the GitHub profile so commits show as Verified.
    signingkey = key::ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIKm12jvyioTIcvXipYjl+s5tB6Xm/sVilqgJan5/4FMV github_axiom

[init]
    defaultBranch = main

[push]
    default = current
    autoSetupRemote = true

[pull]
    rebase = true

[core]
    editor = nvim
    autocrlf = input
    pager = delta

[interactive]
    diffFilter = delta --color-only

[delta]
    navigate = true
    side-by-side = true
    line-numbers = true

[color]
    ui = true

[diff]
    algorithm = histogram
    colorMoved = default

[merge]
    conflictstyle = zdiff3

[rebase]
    autoStash = true
    autoSquash = true

[alias]
    st = status
    co = checkout
    br = branch
    ci = commit
    lg = log --oneline --graph --decorate --all
    unstage = reset HEAD --
    last = log -1 HEAD
    dft = "!f() { GIT_EXTERNAL_DIFF=difft git diff \"$@\"; }; f"
    dftl = "!f() { GIT_EXTERNAL_DIFF=difft git log -p --ext-diff \"$@\"; }; f"

[credential "https://github.com"]
    helper =
    helper = !/usr/bin/env gh auth git-credential

[credential "https://gist.github.com"]
    helper =
    helper = !/usr/bin/env gh auth git-credential

[filter "lfs"]
    clean = git-lfs clean -- %f
    smudge = git-lfs smudge -- %f
    process = git-lfs filter-process
    required = true

# ── Commit signing ──────────────────────────────────────────────────────────
# Sign all commits and tags by default using SSH (key from Bitwarden agent).
# The allowed_signers file is populated by infra/dotfiles.sh so that
# `git log --show-signature` can verify signatures locally.
[gpg]
    format = ssh

[gpg "ssh"]
    allowedSignersFile = ~/.config/git/allowed_signers

[commit]
    gpgsign = true

[tag]
    gpgsign = true
